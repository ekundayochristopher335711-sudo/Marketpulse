# Frontend variables must be prefixed with VITE_. Never expose secret keys here.
VITE_API_BASE_URL=http://localhost:8000
# Optional bearer token for a private deployed/read-only API. Leave empty for local development.
VITE_API_READ_TOKEN=
# Public Supabase Auth settings for the Reports sign-in screen. The publishable key is safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Configure OpenAI only on the backend, never in VITE_ variables.
