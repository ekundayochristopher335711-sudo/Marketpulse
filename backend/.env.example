# Keep secrets here on the server only. Never commit this file.
OPENAI_API_KEY=
OPENAI_MODEL=
# Supabase Auth verifies signed-in AI users; this publishable key is not a database secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated email allowlist for the paid AI endpoint. Leave empty to keep it disabled.
MARKETPULSE_AI_ALLOWED_EMAILS=
MARKETPULSE_AI_DAILY_LIMIT=10
MARKETPULSE_AI_REQUESTS_PER_MINUTE=3
DATABASE_URL=sqlite:///./marketpulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional protection for read-only API endpoints. Leave empty for local development.
MARKETPULSE_READ_TOKEN=
# Per-process fallback limiter for read endpoints.
MARKETPULSE_RATE_LIMIT_PER_MINUTE=120
# Optional browser-backed collection for dynamic authorized pages. Keep disabled
# until the approved source scope and browser runtime are ready.
MARKETPULSE_JIJI_PLAYWRIGHT=0
MARKETPULSE_PLAYWRIGHT_STORAGE_STATE=
# Optional Jax category page. Leave empty for the bounded all-ads page, or set
# a slug such as mobile-phones-tablets to collect that public category page.
MARKETPULSE_JAX_CATEGORY_PAGE=
# Meta Content Library credentials are required for the Facebook Marketplace
# connector. Never put this token in VITE_ frontend variables.
MARKETPULSE_FACEBOOK_ACCESS_TOKEN=
MARKETPULSE_FACEBOOK_API_VERSION=v24.0
MARKETPULSE_FACEBOOK_API_ROOT=https://graph.facebook.com
# Generate a long random value before enabling worker ingestion.
MARKETPULSE_INGEST_TOKEN=
# Separate operator credential for source approval/configuration.
MARKETPULSE_ADMIN_TOKEN=
