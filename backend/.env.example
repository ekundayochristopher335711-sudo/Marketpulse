# Keep secrets here on the server only. Never commit this file.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=sqlite:///./marketpulse.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional protection for read-only API endpoints. Leave empty for local development.
MARKETPULSE_READ_TOKEN=
# Per-process fallback limiter for read endpoints.
MARKETPULSE_RATE_LIMIT_PER_MINUTE=120
# Optional browser-backed collection for dynamic authorized pages. Keep disabled
# until the approved source scope and browser runtime are ready.
MARKETPULSE_JIJI_PLAYWRIGHT=0
MARKETPULSE_PLAYWRIGHT_STORAGE_STATE=
# Generate a long random value before enabling worker ingestion.
MARKETPULSE_INGEST_TOKEN=
# Separate operator credential for source approval/configuration.
MARKETPULSE_ADMIN_TOKEN=
